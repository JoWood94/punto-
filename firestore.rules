rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ───────────────────────────────────────────────────────
    // Schema validator per notes tipizzate (Fase 0 shared-calendars.md).
    // Applicato a create/update in modo da impedire doc malformati post-migrazione.

    function isValidNoteType(data) {
      return data.type in ['note', 'memo', 'event'];
    }

    function isValidImage(data) {
      // Immagine opzionale. Se presente deve essere base64 string <300KB
      // e mimeType in whitelist (JPEG/PNG/WebP).
      return !('image' in data) || (
        data.image.data is string &&
        data.image.data.size() < 300000 &&
        data.image.mimeType in ['image/jpeg', 'image/png', 'image/webp']
      );
    }

    function isValidTypedNote(data) {
      // - type obbligatorio in whitelist
      // - se type=='event' → calendarId richiesto e stringa
      // - se type=='event' → eventStart required (number) e eventEnd >= eventStart se presente
      // - se type=='note' → hasReminderBlock deve essere false (denormalizzato dal FE
      //   al save; previene ReminderBlock dentro una nota "pura")
      // - image opzionale con constraint di size/mime
      return 'type' in data &&
        isValidNoteType(data) &&
        (data.type != 'event' || ('calendarId' in data && data.calendarId is string)) &&
        (data.type != 'event' || ('eventStart' in data && data.eventStart is number)) &&
        (data.type != 'event' || !('eventEnd' in data) || (data.eventEnd is number && data.eventEnd >= data.eventStart)) &&
        (data.type != 'note' || data.hasReminderBlock == false) &&
        isValidImage(data);
    }

    // Fase 3: per gli eventi il calendario referenziato deve esistere ed
    // essere owned dallo scrittore. Evita che un utente "piazzi" eventi
    // in calendari altrui. Usa get() → costa 1 read per write (accettabile).
    function eventCalendarOwnedByWriter(data) {
      return data.type != 'event' ||
        get(/databases/$(database)/documents/calendars/$(data.calendarId)).data.uid == request.auth.uid;
    }

    // Fase 3: un utente è "visitor" di un evento se è sub del calendario
    // che lo contiene. Usato per allargare la read degli eventi ai subscriber.
    function isSubscriberOfEventCalendar(noteData) {
      return noteData.type == 'event' &&
        'calendarId' in noteData &&
        exists(/databases/$(database)/documents/calendars/$(noteData.calendarId)/subscribers/$(request.auth.uid));
    }

    // Share-by-code: validator del LOOKUP (doc id di invites/{code}).
    // 8 char dall'alfabeto unambiguous-base32 UPPERCASE (no 0/O/I/1/l).
    // Il client DEVE normalizzare a uppercase prima di read/write.
    function isValidLookup(lookup) {
      return lookup.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{8}$');
    }

    // ── Notes ──────────────────────────────────────────────────────────────────
    match /notes/{noteId} {
      // Owner + guest possono leggere.
      // Fase 3: eventi visibili anche ai subscriber del calendario (modello feed).
      // Null-safe: collaboratorUids potrebbe non esistere su note vecchie.
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        ('collaboratorUids' in resource.data &&
         request.auth.uid in resource.data.collaboratorUids) ||
        isSubscriberOfEventCalendar(resource.data)
      );

      // Solo l'owner può creare + schema valido.
      // Fase 3: se type='event', `calendarId` deve puntare a un calendario
      // di cui `request.auth.uid` è owner (no piazzamenti cross-utente).
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        isValidTypedNote(request.resource.data) &&
        eventCalendarOwnedByWriter(request.resource.data);

      // Owner: aggiornamento libero
      // Guest esistente: può aggiornare contenuto ma non uid/collaboratorUids
      // Guest può rimuovere SOLO se stesso da collaboratorUids (lascia la nota)
      // Nuovo guest via invite: può aggiungere SOLO se stesso a collaboratorUids
      // In ogni caso lo schema tipizzato deve essere valido post-update.
      // Fase 3: il calendarId di un event deve sempre puntare a un calendar
      // owned. Evita che l'owner sposti un evento in un calendario altrui.
      allow update: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        (
          'collaboratorUids' in resource.data &&
          request.auth.uid in resource.data.collaboratorUids &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.collaboratorUids == resource.data.collaboratorUids
        ) ||
        (
          'collaboratorUids' in resource.data &&
          request.auth.uid in resource.data.collaboratorUids &&
          request.resource.data.uid == resource.data.uid &&
          !(request.auth.uid in request.resource.data.collaboratorUids) &&
          request.resource.data.collaboratorUids.size() == resource.data.collaboratorUids.size() - 1
        ) ||
        (
          !('collaboratorUids' in resource.data && request.auth.uid in resource.data.collaboratorUids) &&
          request.auth.uid in request.resource.data.collaboratorUids &&
          request.resource.data.uid == resource.data.uid
        )
      ) && isValidTypedNote(request.resource.data)
        && (resource.data.uid != request.auth.uid || eventCalendarOwnedByWriter(request.resource.data));

      // Solo l'owner può eliminare.
      // Nota: in Fase 3 la cascade delete dal CalendarService cancella gli eventi
      // in batch; quelli sono owned dallo stesso uid (rule copre il caso).
      allow delete: if request.auth != null &&
        resource.data.uid == request.auth.uid;

      // ── Presence subcollection ──────────────────────────────────────────────
      // Traccia chi sta guardando/modificando una nota condivisa in tempo reale
      match /presence/{userId} {
        // Owner e collaboratori possono leggere le presenze
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/notes/$(noteId)).data.uid == request.auth.uid ||
          ('collaboratorUids' in get(/databases/$(database)/documents/notes/$(noteId)).data &&
           request.auth.uid in get(/databases/$(database)/documents/notes/$(noteId)).data.collaboratorUids)
        );
        // Create/update: solo sul proprio doc, e solo se owner/collaborator della nota.
        allow create, update: if request.auth != null && userId == request.auth.uid && (
          get(/databases/$(database)/documents/notes/$(noteId)).data.uid == request.auth.uid ||
          ('collaboratorUids' in get(/databases/$(database)/documents/notes/$(noteId)).data &&
           request.auth.uid in get(/databases/$(database)/documents/notes/$(noteId)).data.collaboratorUids)
        );
        // Delete: il diretto interessato, OPPURE l'owner della nota (cleanup su kick).
        // Necessario per rimuovere subito la presence di un guest rimosso: il guest
        // kickato non ha più accesso alla nota e non può cancellare il proprio doc.
        allow delete: if request.auth != null && (
          userId == request.auth.uid ||
          get(/databases/$(database)/documents/notes/$(noteId)).data.uid == request.auth.uid
        );
      }

      // ── Reminder snoozes subcollection ─────────────────────────────────────
      // Ogni utente (owner o collaborator) può snoozare un reminder solo per sé.
      // Doc id = uid snoozato. Scope = istanza corrente del reminder (cancellato dal cron).
      match /reminderSnoozes/{uid} {
        // Subscription reminder per-user (Fase 1): { muted, snoozedUntil }.
        // muted=true → silenzia sempre; snoozedUntil=int → snooze temporaneo (max 7gg);
        // entrambi falsi → client elimina il doc (stato default = notifica attiva).
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/notes/$(noteId)).data.uid == request.auth.uid ||
          uid == request.auth.uid
        );
        // Write: solo sul proprio subdoc, solo owner/collaborator della nota.
        allow create, update: if request.auth != null &&
          uid == request.auth.uid &&
          (
            get(/databases/$(database)/documents/notes/$(noteId)).data.uid == request.auth.uid ||
            ('collaboratorUids' in get(/databases/$(database)/documents/notes/$(noteId)).data &&
             request.auth.uid in get(/databases/$(database)/documents/notes/$(noteId)).data.collaboratorUids)
          ) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.snoozedBy == request.auth.uid &&
          request.resource.data.muted is bool &&
          (
            // snoozedUntil è esplicitamente null (nessuno snooze temporaneo attivo)…
            request.resource.data.snoozedUntil == null ||
            // …oppure int nel futuro e max +7 giorni (previene "snooze eterni")
            (
              request.resource.data.snoozedUntil is int &&
              request.resource.data.snoozedUntil > request.time.toMillis() &&
              request.resource.data.snoozedUntil <= request.time.toMillis() + 604800000
            )
          );
        // Delete: il proprio subdoc (riattiva) oppure l'owner della nota.
        allow delete: if request.auth != null && (
          uid == request.auth.uid ||
          get(/databases/$(database)/documents/notes/$(noteId)).data.uid == request.auth.uid
        );
      }

      // ── Event reminders subcollection (per-user reminder per eventi) ───────
      // Modello: ogni utente (owner del calendar + subscriber) ha il proprio
      // doc con la lista degli offset minuti pre-evento (es. [10, 60, 1440]).
      // Il cron calcola targetTime = eventStart - offset*60s e invia push se
      // matcha l'orario corrente. `sentOffsets` evita doppi invii per la
      // stessa istanza. Default per il guest: doc inesistente = nessun reminder.
      match /eventReminders/{uid} {
        // Read: solo self (privacy: nessuno legge i reminder altrui).
        // Eccezione owner-cascade: l'owner del calendar dell'evento può leggere
        // per cleanup al delete dell'evento. Usa get() su notes/{noteId}.
        allow read: if request.auth != null && (
          uid == request.auth.uid ||
          get(/databases/$(database)/documents/notes/$(noteId)).data.uid == request.auth.uid
        );

        // Create: solo self. Il documento parent (notes/{noteId}) deve essere
        // un evento di cui sono owner del calendar OPPURE subscriber.
        // Schema valido: uid coerente, offsetsMinutes lista di int >=0.
        allow create: if request.auth != null &&
          uid == request.auth.uid &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.offsetsMinutes is list &&
          request.resource.data.sentOffsets is list &&
          (
            get(/databases/$(database)/documents/notes/$(noteId)).data.uid == request.auth.uid ||
            isSubscriberOfEventCalendar(get(/databases/$(database)/documents/notes/$(noteId)).data)
          );

        // Update: solo self, schema invariato, no cambio uid.
        allow update: if request.auth != null &&
          uid == request.auth.uid &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.offsetsMinutes is list &&
          request.resource.data.sentOffsets is list;

        // Delete: self (rimuove i propri reminder) OR owner dell'evento (cascade).
        allow delete: if request.auth != null && (
          uid == request.auth.uid ||
          get(/databases/$(database)/documents/notes/$(noteId)).data.uid == request.auth.uid
        );
      }

      // ── Collaborators subcollection ─────────────────────────────────────────
      match /collaborators/{collabId} {
        // Owner e tutti i guest possono leggere (serve a updateNote() per check permessi)
        // Null-safe: collaboratorUids potrebbe non esistere su note vecchie
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/notes/$(noteId)).data.uid == request.auth.uid ||
          ('collaboratorUids' in get(/databases/$(database)/documents/notes/$(noteId)).data &&
           request.auth.uid in get(/databases/$(database)/documents/notes/$(noteId)).data.collaboratorUids)
        );
        // Owner: scrittura completa
        // Guest: può creare il proprio subdoc (per invite acceptance via addCollaborator)
        allow write: if request.auth != null && (
          get(/databases/$(database)/documents/notes/$(noteId)).data.uid == request.auth.uid ||
          collabId == request.auth.uid
        );
      }

      // ── SharedKeys subcollection (E2EE share-by-code) ───────────────────────
      // Ogni nota condivisa ha una AES-256 key simmetrica usata per cifrare
      // title/content/blocks. La AES key viene "wrappata" con la PGP public
      // key di ciascun partecipante e salvata qui come doc id = uid.
      //
      // Schema doc:
      //   {
      //     wrappedKey: string (PGP-encrypted AES key, ASCII armored, max 2000 char),
      //     wrappedAt:  timestamp (server timestamp alla write),
      //     wrappedBy:  string (uid di chi ha scritto il wrap — owner al bootstrap,
      //                         self al primo join via code)
      //   }
      //
      // Questa subcollection risolve multi-device: ogni device dello stesso
      // uid decifra il wrap con la propria encryptedPrivateKey utente.
      //
      // Multi-device note: il PGP public key per uid è unico (persistito su
      // users/{uid}.publicKey), quindi il wrap è condiviso fra i device.
      match /sharedKeys/{uid} {
        // Read: SOLO self. Il wrap di altri utenti non deve mai essere letto —
        // anche l'owner non deve poter leggere il wrap altrui (defence in depth:
        // un owner compromesso non può copiare i wrap e replay-attaccare).
        allow read: if request.auth != null && uid == request.auth.uid;

        // Create/Update: due path consentiti.
        //   a) Owner della nota → bootstrap iniziale di qualsiasi {uid}
        //      (scrive il proprio wrap al primo share, e può pre-wrappare
        //      per collaboratori aggiunti manualmente se esiste flusso out-of-band).
        //   b) Self → auto-wrap al primo join (guest incolla code, decifra con
        //      la KEY del code, ri-wrappa con la propria PGP pub, scrive qui).
        // Validazione schema: wrappedKey string non vuota e max 2000 char
        // (PGP ed25519 di AES-256 è ~600-800 char ASCII armored; 2000 è margine).
        allow create, update: if request.auth != null &&
          (
            get(/databases/$(database)/documents/notes/$(noteId)).data.uid == request.auth.uid ||
            uid == request.auth.uid
          ) &&
          request.resource.data.wrappedKey is string &&
          request.resource.data.wrappedKey.size() > 0 &&
          request.resource.data.wrappedKey.size() <= 2000 &&
          request.resource.data.wrappedBy is string &&
          request.resource.data.wrappedBy == request.auth.uid &&
          request.resource.data.wrappedAt is timestamp;

        // Delete: owner della nota (cleanup al kickout di un collaborator o
        // alla cancellazione nota) OPPURE self (quando si lascia la nota).
        allow delete: if request.auth != null && (
          get(/databases/$(database)/documents/notes/$(noteId)).data.uid == request.auth.uid ||
          uid == request.auth.uid
        );
      }
    }

    // ── Users ──────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Qualsiasi utente autenticato può leggere (serve per getUsernameByUid nei collaboratori)
      allow read: if request.auth != null;
      // Solo il proprietario può scrivere (FCM tokens, preferenze, username)
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Usernames (lookup uid→username e check disponibilità) ──────────────────
    match /usernames/{username} {
      // Lettura pubblica: checkUsernameAvailability viene chiamata dal form di
      // registrazione PRIMA che l'utente sia autenticato
      allow read;
      allow write: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // ── Invites (share-by-code) ────────────────────────────────────────────────
    // Schema share-by-code (big-bang, no backcompat col vecchio token 20-char):
    //   doc id = LOOKUP = 8 char dall'alfabeto [ABCDEFGHJKMNPQRSTUVWXYZ23456789]
    //            (~40 bit entropia, no caratteri ambigui: no 0/O/I/1/l)
    //   Il client normalizza a uppercase PRIMA della write/read.
    //   La "KEY" (AES-256 in base64url) vive SOLO nel codice LOOKUP-KEY
    //   che l'utente si scambia — NON è mai persistita in Firestore.
    //
    // Payload invariato rispetto a Fase 3:
    //   { type: 'note'|'calendar', resourceId, createdBy, createdAt, expiresAt }
    //
    // TTL:
    //   - note: 365 giorni (revoca manuale via delete, no cleanup cron)
    //   - calendar: 30 giorni (sotto il cap universale, OK)
    //   Cap hard universale enforceato da rules: expiresAt <= now + 366 giorni.
    //   Margine di 1 giorno sopra i 365 per tollerare lag client/server.
    //
    // Vincolo "uno share code attivo per nota" NON è enforceable in rules
    // (servirebbe una query). Il client garantisce il vincolo cancellando
    // eventuali vecchi invite della stessa nota prima del create.
    match /invites/{inviteId} {
      // Chiunque autenticato può leggere (per acceptInvite, getActiveInvite,
      // readCalendarInvite). Il LOOKUP è la barriera di enumerazione (~40 bit),
      // il cipher E2EE impedisce leak del contenuto anche in caso di brute-force.
      allow read: if request.auth != null;

      // Owner crea il proprio invite con validazione schema minima.
      // Validiamo il LOOKUP con regex (helper top-level) — il client DEVE
      // normalizzare a uppercase. Big-bang: no backcompat col vecchio 20-char.
      // - doc id deve essere LOOKUP valido (8 char alfabeto unambiguous).
      // - `type` obbligatorio in whitelist.
      // - `resourceId` obbligatorio (noteId del legacy rimosso).
      // - `expiresAt` nel futuro, e MAX +366 giorni (cap hard lato rules, universale
      //   per tutti i type; note usa 365, calendar 30 — entrambi sotto il cap).
      allow create: if request.auth != null &&
        isValidLookup(inviteId) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.expiresAt is int &&
        request.resource.data.expiresAt > request.time.toMillis() &&
        request.resource.data.expiresAt <= request.time.toMillis() + 366 * 86400 * 1000 &&
        request.resource.data.type in ['note', 'calendar'] &&
        'resourceId' in request.resource.data &&
        request.resource.data.resourceId is string &&
        request.resource.data.resourceId.size() > 0;

      // Delete: solo l'owner → revoca dell'invite (nuovi join impossibili,
      // chi è già dentro resta — kickout gestito separatamente su collaborators).
      allow delete: if request.auth != null &&
        resource.data.createdBy == request.auth.uid;
    }

    // ── Calendars (Fase 3) ─────────────────────────────────────────────────────
    // Entity calendario con sharing modello "feed":
    //   - Chiunque conosca calId + valido invite può iscriversi (self-service)
    //   - Owner NON vede lista subscribers (privacy)
    //   - Eventi (type='event') vivono in `notes` e sono leggibili ai sub
    match /calendars/{calId} {
      // Read: owner OR subscriber (esiste subdoc subscribers/{myUid}).
      // Usiamo exists() — costo 1 read extra — per non esporre l'esistenza del
      // calendar a chi non è coinvolto (chi non è sub vede "permission denied").
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        exists(/databases/$(database)/documents/calendars/$(calId)/subscribers/$(request.auth.uid))
      );

      // Create: il doc deve appartenere al creatore.
      // Nessuna validazione `isDefault` qui (flag informativa UI).
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;

      // Update / Delete: solo owner. `uid` immutabile (altrimenti l'owner
      // potrebbe regalare il calendario a un altro uid → vietato).
      allow update: if request.auth != null &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == resource.data.uid;
      allow delete: if request.auth != null &&
        resource.data.uid == request.auth.uid;

      // ── Subscribers subcollection ───────────────────────────────────────────
      // Modello feed: ogni utente gestisce il proprio subdoc. Nessuna list
      // dell'owner (privacy intenzionale). Il calId stesso è la barriera di
      // enumerazione (20 char Firestore auto-id).
      match /subscribers/{subUid} {
        // Read: solo self. L'owner NON può listare la subcollection.
        // Eccezione: per permettere la cascade delete nel CalendarService
        // (deleteCalendar → query subscribers + delete), ALLARGHIAMO la read
        // all'owner del calendar. Trade-off privacy vs praticità: senza questa
        // eccezione servirebbe una Cloud Function (BL-1) per la cascade.
        // Se servisse privacy stretta: rimuovere la seconda clausola e
        // delegare la cleanup a un job server-side.
        allow read: if request.auth != null && (
          subUid == request.auth.uid ||
          get(/databases/$(database)/documents/calendars/$(calId)).data.uid == request.auth.uid
        );

        // Create: solo su se stessi (subUid == self) + doc coerente.
        // Due path:
        //   a) Owner auto-iscrizione al setup del calendar (role='owner').
        //   b) Sub esterno che consuma un invite → `role='subscriber'`,
        //      `notificationsEnabled` libero (default false lato client).
        // Il calId è la barriera di enumerazione; NON verifichiamo l'esistenza
        // dell'invite in rules (costoso + token non conosciuto al livello rule).
        // Modello feed: chi ha il calId può iscriversi.
        allow create: if request.auth != null &&
          subUid == request.auth.uid &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.role in ['owner', 'subscriber'] &&
          request.resource.data.notificationsEnabled is bool &&
          // Owner auto-iscrizione consentita solo al vero owner
          (
            request.resource.data.role != 'owner' ||
            get(/databases/$(database)/documents/calendars/$(calId)).data.uid == request.auth.uid
          );

        // Update: solo self, e solo il campo `notificationsEnabled` può cambiare.
        // Enforcement: diff().affectedKeys() deve essere subset di {notificationsEnabled}.
        allow update: if request.auth != null &&
          subUid == request.auth.uid &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['notificationsEnabled']);

        // Delete: self (unsubscribe) OR owner del calendar (cascade su deleteCalendar).
        allow delete: if request.auth != null && (
          subUid == request.auth.uid ||
          get(/databases/$(database)/documents/calendars/$(calId)).data.uid == request.auth.uid
        );
      }
    }

    // ── Collection group query per subscribers ─────────────────────────────────
    // CalendarService.getSubscribedCalendars usa
    //   collectionGroup('subscribers') where('uid','==',myUid)
    // per trovare tutti i calendari (owned o subscribed) di cui l'utente è sub.
    // Firestore richiede una rule list dedicata per le collection group query:
    // la rule scoped `/calendars/{calId}/subscribers/{subUid}` non basta perché
    // valuta `subUid == auth.uid` (path var, doc-id) mentre la query filtra sul
    // campo `data.uid`. Riproponiamo la rule con `resource.data.uid` che Firestore
    // riconosce come globalmente true grazie al filtro `where('uid','==',auth.uid)`.
    match /{path=**}/subscribers/{subUid} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
  }
}
