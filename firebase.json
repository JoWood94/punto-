{
  "hosting": {
    "public": "frontend/dist/firebase/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          { "key": "Clear-Site-Data", "value": "\"cache\", \"storage\"" }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          { "key": "Clear-Site-Data", "value": "\"cache\", \"storage\"" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
