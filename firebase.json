{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "target": "production",
      "public": "frontend/dist/firebase/browser",
      "ignore": [
        "firebase.json",
        "**/.DS_Store",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/index.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/ngsw.json",
          "headers": [{ "key": "Cache-Control", "value": "no-store" }]
        },
        {
          "source": "/ngsw-worker.js",
          "headers": [{ "key": "Cache-Control", "value": "no-store" }]
        },
        {
          "source": "/version.json",
          "headers": [{ "key": "Cache-Control", "value": "no-store" }]
        },
        {
          "source": "/combined-sw.js",
          "headers": [{ "key": "Cache-Control", "value": "no-store" }]
        },
        {
          "source": "/.well-known/apple-app-site-association",
          "headers": [
            { "key": "Content-Type", "value": "application/json" },
            { "key": "Cache-Control", "value": "no-cache" }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "staging",
      "public": "frontend/dist/firebase/browser",
      "ignore": [
        "firebase.json",
        "**/.DS_Store",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/index.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/ngsw.json",
          "headers": [{ "key": "Cache-Control", "value": "no-store" }]
        },
        {
          "source": "/ngsw-worker.js",
          "headers": [{ "key": "Cache-Control", "value": "no-store" }]
        },
        {
          "source": "/version.json",
          "headers": [{ "key": "Cache-Control", "value": "no-store" }]
        },
        {
          "source": "/combined-sw.js",
          "headers": [{ "key": "Cache-Control", "value": "no-store" }]
        },
        {
          "source": "/.well-known/apple-app-site-association",
          "headers": [
            { "key": "Content-Type", "value": "application/json" },
            { "key": "Cache-Control", "value": "no-cache" }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
